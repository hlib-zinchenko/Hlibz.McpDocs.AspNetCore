<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Hlibz.McpDocs.AspNetCore</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup Label="NuGet metadata">
    <PackageId>Hlibz.McpDocs.AspNetCore</PackageId>
    <Authors>Hlib Zinchenko</Authors>
    <Description>ReDoc-style documentation page for MCP servers hosted in ASP.NET Core, with an optional try-it console.</Description>
    <PackageTags>mcp;model-context-protocol;aspnetcore;docs;documentation</PackageTags>
    <PackageProjectUrl>https://github.com/hlib-zinchenko/Hlibz.McpDocs.AspNetCore</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hlib-zinchenko/Hlibz.McpDocs.AspNetCore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Below 3.0: [Authorize] filtering and endpoint discovery mirror SDK internals, and a major version may change
         them. Newer 2.x versions are tested weekly (.github/workflows/sdk-latest.yml). The tests and the sample
         run the version in Directory.Packages.props. -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" VersionOverride="[2.3.1,3.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\icon.png" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="Hlibz.McpDocs.AspNetCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\**\*" LogicalName="McpDocs.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
