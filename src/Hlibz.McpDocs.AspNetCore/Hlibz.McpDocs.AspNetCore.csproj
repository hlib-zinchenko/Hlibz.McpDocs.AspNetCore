<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>Hlibz.McpDocs.AspNetCore</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Hlibz.McpDocs.AspNetCore</PackageId>
    <Version>0.1.3</Version>
    <Authors>Hlib Zinchenko</Authors>
    <Description>Read-only, ReDoc-style documentation page for MCP servers hosted in ASP.NET Core.</Description>
    <RepositoryUrl>https://github.com/hlib-zinchenko/Hlibz.McpDocs.AspNetCore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/hlib-zinchenko/Hlibz.McpDocs.AspNetCore</PackageProjectUrl>
    <PackageTags>mcp;model-context-protocol;aspnetcore;docs;documentation</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\icon.png" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="Hlibz.McpDocs.AspNetCore.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\**\*" LogicalName="McpDocs.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
