<Project>

    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <!-- net10.0 is the floor; net11.0 gives a .NET 11 app an assembly built and analyzed against
         its own framework. The test projects run both. -->
    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    </PropertyGroup>

</Project>
